{
  "name": "@semaphile/messaging",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/shared.d.ts",
      "import": "./dist/src/shared.js"
    },
    "./agent-messages": {
      "types": "./dist/src/agent-messages.d.ts",
      "import": "./dist/src/agent-messages.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings src/*.ts *.mjs",
    "lint:types": "oxlint --config ../../.oxlintrc.json --type-aware --deny-warnings src/*.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "c8": "12.0.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "@semaphile/core": "file:../core",
    "@semaphile/redis": "file:../redis",
    "@semaphile/otel": "file:../otel"
  },
  "bin": {
    "semaphile": "dist/src/cli.js"
  },
  "peerDependencies": {
    "@semaphile/core": "0.3.0",
    "@semaphile/redis": "0.3.0",
    "@semaphile/otel": "0.3.0"
  },
  "peerDependenciesMeta": {
    "@semaphile/core": {
      "optional": true
    },
    "@semaphile/redis": {
      "optional": true
    },
    "@semaphile/otel": {
      "optional": true
    }
  },
  "license": "MIT",
  "description": "Durable local agent messaging with SQLite mailboxes and the semaphile CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semaphile/semaphile.git",
    "directory": "packages/messaging"
  },
  "homepage": "https://github.com/semaphile/semaphile/tree/main/packages/messaging#readme",
  "bugs": {
    "url": "https://github.com/semaphile/semaphile/issues"
  },
  "keywords": [
    "agents",
    "coordination",
    "typescript",
    "messaging"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
