# Terraform working data, state, saved plans and real inputs never enter Git.
# run.sh keeps them in the caller's private SEM3_CLOUD_DIR; these rules also
# catch anything generated here by hand. The provider lock file is tracked.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Generated Ansible inventory, logs and retries.
inventory.ini
*.retry
ansible.log
# Everything else run.sh writes into its private directory, in case a
# copy lands here: the per-run SSH key, pinned host keys, outputs, plan
# and apply text, logs and the Linux run state.
id_ed25519
id_ed25519.pub
known_hosts
outputs.json
run.tfvars.json
*.tfplan.txt
*.tfplan.actions.txt
apply.txt
destroy.txt
replan.txt
run.log
linux-run.json
teardown-host.log
ansible-*.log
tfdata/
tfdata-validate/
ansible-tmp/
