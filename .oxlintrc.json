{
  "$schema": "./packages/core/node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", ".tmp/**", ".scratch/**", "**/._*"],
  "rules": {
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "curly": ["error", "all"]
  },
  "overrides": [
    {
      "files": ["conformance/typescript/consumer.ts"],
      "rules": {
        "no-unused-vars": "off",
        "no-unused-expressions": "off",
        "typescript/consistent-type-imports": "off",
        "unicorn/no-thenable": "off"
      }
    },
    {
      "files": [
        "conformance/typescript/fixtures/backend.ts",
        "conformance/typescript/fixtures/participant.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
